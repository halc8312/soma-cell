+def _cache_plain(value):
+    """Canonical, finite JSON values; never drop unknown configuration fields."""
+    if isinstance(value, np.ndarray):
+        return {'dtype': value.dtype.str, 'shape': list(value.shape),
+                'values': _cache_plain(value.tolist())}
+    if isinstance(value, np.generic):
+        return _cache_plain(value.item())
+    if isinstance(value, dict):
+        if any(not isinstance(k, str) for k in value):
+            raise TypeError('configuration keys must be strings')
+        return {k: _cache_plain(v) for k, v in value.items()}
+    if isinstance(value, (tuple, list)):
+        return [_cache_plain(v) for v in value]
+    if value is None or isinstance(value, (bool, str, int)):
+        return value
+    if isinstance(value, float):
+        if not math.isfinite(value):
+            raise ValueError('nonfinite evaluation context')
+        return value
+    raise TypeError('unsupported evaluation context: ' + type(value).__name__)
+
+
+def evaluation_cache_context(sequence, environment, evaluation_seeds, seconds):
+    """Identity includes every symbol, evaluated config, runtime and dependency bytes.
+
+    grammar_signature is retained for descriptive summaries only. This cache
+    is local to one assay and contains no serialized cross-run score storage.
+    """
+    raw = np.asarray(sequence)
+    if raw.ndim != 1 or raw.dtype.kind not in 'ui' or np.any(raw > 7) or np.any(raw < 0):
+        raise ValueError('invalid genome alphabet')
+    seq = raw.astype(np.uint8, copy=False)
+    seconds = float(seconds)
+    if not math.isfinite(seconds) or seconds <= 0.0:
+        raise ValueError('evaluation duration must be finite and positive')
+    cfg = _config_for_traits(grammar_traits_from_sequence(seq), environment)
+    dependencies = {os.path.abspath(__file__)}
+    # All science modules already loaded in this evaluator's dependency chain.
+    for name, module in list(sys.modules.items()):
+        path = getattr(module, '__file__', None)
+        if path and name.startswith('SOMA_CELL_') and name.endswith('_pythonista'):
+            dependencies.add(os.path.abspath(path))
+    source_hashes = {}
+    for path in sorted(dependencies):
+        with open(path, 'rb') as handle:
+            source_hashes[os.path.basename(path)] = hashlib.sha256(handle.read()).hexdigest()
+    return {
+        'key_schema': 'R0-exact-evaluation-v1',
+        'sequence_hex': seq.tobytes().hex(),
+        'sequence_length': len(seq),
+        'sequence_dtype': seq.dtype.str,
+        'environment': str(environment),
+        'evaluation_seeds': [int(s) for s in evaluation_seeds],
+        'seconds': seconds,
+        'simulation_hz': float(SIM_HZ),
+        'configuration': _cache_plain(cfg.state_dict()),
+        'source_sha256': source_hashes,
+        'python': list(sys.version_info[:3]),
+        'numpy': np.__version__,
+        'numeric_dtype': np.dtype(float).str,
+    }
+
+
+def evaluation_cache_key(sequence, environment, evaluation_seeds, seconds):
+    # Exact canonical bytes, not just a truncated digest, are the in-memory key.
+    return json.dumps(evaluation_cache_context(sequence, environment, evaluation_seeds, seconds),
+                      sort_keys=True, separators=(',', ':'), allow_nan=False)
+
+
