{
  "schema_id": "SOMA-CELL-0.6.8-GPU-A4.1-ragged-genome",
  "status": "development_slice_not_promoted",
  "full_gpu_world_step": false,
  "scope": "one_world_structural_genome_state",
  "sequence_order": [
    "complete_genomes_in_list_order",
    "replication_template_when_active",
    "replication_copy_when_active_including_empty"
  ],
  "arrays": {
    "symbols": {"dtype": "uint8", "shape": ["symbol_capacity"], "unused": 0},
    "sequence_offsets": {"dtype": "int64", "shape": ["sequence_capacity + 1"], "unused": -1},
    "cell_sequence_offsets": {"dtype": "int64", "shape": ["cell_capacity + 1"], "unused": -1},
    "cell_ids": {"dtype": "int64", "shape": ["cell_capacity"], "unused": -1},
    "cell_mask": {"dtype": "bool", "shape": ["cell_capacity"], "unused": false},
    "genome_counts": {"dtype": "int64", "shape": ["cell_capacity"], "unused": 0},
    "lesion_offsets": {"dtype": "int64", "shape": ["cell_capacity + 1"], "unused": -1},
    "genome_lesions": {"dtype": "float64", "shape": ["sequence_capacity"], "unused": 0.0},
    "replication_active": {"dtype": "bool", "shape": ["cell_capacity"], "unused": false},
    "replication_template_lesions": {"dtype": "float64", "shape": ["cell_capacity"], "unused": 0.0},
    "replication_fractional": {"dtype": "float64", "shape": ["cell_capacity"], "unused": 0.0}
  },
  "scalar_counts": ["cell_count", "sequence_count", "symbol_count", "lesion_count"],
  "capacities": ["cell_capacity", "sequence_capacity", "symbol_capacity", "max_sequence_symbols"],
  "invariants": [
    "all used symbols are integers in [0,7]",
    "used offsets start at zero and are monotonic",
    "terminal offsets equal used counts",
    "unused tails contain only their declared sentinel",
    "cell_sequence_count equals genome_count plus two when replication is active",
    "lesion_count per cell does not exceed complete genome count",
    "active template length is positive and copy length does not exceed template length",
    "inactive replication has zero template lesion and zero fractional progress",
    "material symbols exclude the replication template",
    "capacity overflow fails before mutation"
  ],
  "cpu_authoritative_after_slice": [
    "gene_cache_and_translation",
    "replication_proofreading_mutation_hydrolysis_rng",
    "division_death_corpse_edna_hgt",
    "neural_and_causal_systems"
  ]
}
